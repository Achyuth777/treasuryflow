{
  "name": "treasuryflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build-hosted.mjs",
    "test": "node --test --test-concurrency=1 chain/*.test.mjs tests/*.test.mjs",
    "chain": "node chain/server.mjs",
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "demo:api": "node scripts/demo-api.mjs",
    "build:demo": "tsc --noEmit && node scripts/build.mjs"
  },
  "dependencies": {
    "ethers": "6.14.4",
    "ganache": "7.9.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "solc": "0.8.30"
  },
  "devDependencies": {
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "esbuild": "0.25.5",
    "jsdom": "^26.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
